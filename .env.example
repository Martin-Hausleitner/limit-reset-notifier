# Copy to .env.deploy (gitignored) and fill in real values.
# run.sh sources this file and exports the variables to the Node scripts.

VCVM_HOST=your-ssh-host                 # SSH alias/host of the PUBLIC dashboard server
PUBLIC_IP=                              # (optional) its public IP, for reference
PORT=8799                              # port the dashboard binds on that host
DASH_USER=admin                        # dashboard Basic-Auth username
DASH_PASS=change-me                    # dashboard Basic-Auth password
DASHBOARD_URL=https://example.trycloudflare.com   # public URL (cloudflared / Funnel)

MATRIX_HOMESERVER_URL=https://matrix.example.org  # your Matrix homeserver base URL
MATRIX_USER_ID=@user:example.org       # only used by the optional Element screenshot
MATRIX_DEVICE_ID=DEVICE                # only used by the optional Element screenshot

# The Matrix ACCESS TOKEN is never stored here. It is read at runtime from:
#   1) $MATRIX_TOKEN, or
#   2) the macOS keychain:  security find-generic-password -s matrix-archive-sync -a "$USER" -w
