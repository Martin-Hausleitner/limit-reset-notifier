+function formatTokensPerMinute(tpm: number): string {
+  if (tpm >= 1_000_000) return `${(tpm / 1_000_000).toFixed(2)}M`;
+  if (tpm >= 1_000) return `${(tpm / 1_000).toFixed(tpm >= 100_000 ? 0 : 1)}K`;
+  return `${Math.round(tpm)}`;
+}
+
+function AiLimitsCard({ data }: { data: NonNullable<DashboardSnapshot["aiLimits"]> }) {
+  const secs = data.nextResetInSeconds;
+  const reset = secs != null
+    ? `in ${Math.floor(secs / 3600)}h ${String(Math.floor((secs % 3600) / 60)).padStart(2, "0")}m`
+    : "—";
+  const provider = data.nextResetProvider ? ` · ${data.nextResetProvider}` : "";
+  const synced = data.syncedAt ? new Date(data.syncedAt).toLocaleTimeString() : "live";
+  return (
+    <section className="section-card">
+      <div className="section-heading">
+        <h2>🔥 AI-Limits</h2>
+        <span className="section-subtle">aktualisiert {synced}</span>
+      </div>
+      <div className="metric-grid">
+        <Metric label="Tokens/min" value={formatTokensPerMinute(data.tokensPerMinute)} accent />
+        <Metric label={`Next Reset${provider}`} value={reset} />
+        {data.claudeSessionUsedPercent != null && (
+          <Metric label="Claude Session" value={`${Math.round(data.claudeSessionUsedPercent)}%`} muted />
+        )}
+        {data.codexSessionUsedPercent != null && (
+          <Metric label="Codex Session" value={`${Math.round(data.codexSessionUsedPercent)}%`} muted />
+        )}
+      </div>
+    </section>
+  );
+}
