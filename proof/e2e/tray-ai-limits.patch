+fn ai_limits_summary(events: &[AwEvent], end: DateTime<Utc>) -> Option<AiLimitsSummary> {
+    let latest = events
+        .iter()
+        .filter(|event| {
+            event
+                .data
+                .get("bucket_id")
+                .and_then(|value| value.as_str())
+                .map(|bucket| bucket.starts_with("aw-watcher-ai-limits"))
+                .unwrap_or(false)
+        })
+        .filter(|event| event_time(event).map(|t| t <= end).unwrap_or(false))
+        .max_by_key(|event| event_time(event).map(|t| t.timestamp_millis()).unwrap_or(i64::MIN))?;
+    let data = &latest.data;
+    let num = |key: &str| data.get(key).and_then(|value| value.as_f64());
+    let int = |key: &str| data.get(key).and_then(|value| value.as_i64());
+    let text = |key: &str| data.get(key).and_then(|value| value.as_str()).map(|s| s.to_string());
+    Some(AiLimitsSummary {
+        tokens_per_minute: num("tokens_per_minute").unwrap_or(0.0),
+        next_reset_label: text("next_reset_label"),
+        next_reset_in_seconds: int("next_reset_in_seconds"),
+        next_reset_provider: text("next_reset_provider"),
+        claude_session_used_percent: num("claude_session_used_percent"),
+        codex_session_used_percent: num("codex_session_used_percent"),
+        synced_at: text("synced_at"),
+    })
+}
